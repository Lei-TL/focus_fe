# Base URL của API Focus_Be. Các route KHÔNG có tiền tố `/api`
# (ví dụ `/auth/login`, `/auth/me`, `/health`).
#
# Chọn giá trị theo nền tảng:
#   - BE local (launchSettings) : http://localhost:5246
#   - Android emulator          : http://10.0.2.2:5246   (10.0.2.2 = localhost của máy host)
#   - Thiết bị thật (LAN)       : http://<IP-máy-chạy-BE>:5246
EXPO_PUBLIC_API_URL=http://localhost:5246
